{
  "name": "digital-dwarf",
  "type": "module",
  "version": "0.0.1",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "test": "node --test tests/**/*.test.mjs && node --experimental-strip-types --test tests/**/*.test.ts",
    "test:unit": "node --test tests/**/*.test.mjs && node --experimental-strip-types --test tests/**/*.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:chromium": "playwright test --project=chromium",
    "lint": "eslint .",
    "generate:og": "node --experimental-strip-types scripts/generate-og.mjs"
  },
  "dependencies": {
    "@astrojs/node": "^10.1.4",
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/onest": "^5.3.1",
    "@tailwindcss/vite": "^4.3.4",
    "astro": "^6.4.6",
    "gsap": "^3.15.1",
    "resend": "^4.5.2",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.4",
    "three": "^0.187.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@types/three": "^0.187.0",
    "autoprefixer": "^10.6.2",
    "eslint": "^10.14.0",
    "eslint-plugin-astro": "^3.2.1",
    "lighthouse": "^13.6.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1"
  }
}
