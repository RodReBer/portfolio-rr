---
import { resolvePreferredLang } from "../data/site";

export const prerender = false;

const preferredLang = resolvePreferredLang(
  Astro.cookies.get("portfolio_lang")?.value,
  Astro.request.headers.get("accept-language"),
);
const response = Astro.redirect(`/${preferredLang}/${Astro.url.search}`, 302);

response.headers.set("Cache-Control", "private, no-store");
response.headers.set("Vary", "Cookie, Accept-Language");

return response;
---
