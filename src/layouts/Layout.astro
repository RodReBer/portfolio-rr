---
import { ClientRouter } from "astro:transitions";
import { getRelativeLocaleUrl } from "astro:i18n";
import Header from "../components/Header.astro";
import { getSiteCopy } from "../data/site";
import Footer from "../components/Footer.astro";
import onestLatinUrl from "@fontsource-variable/onest/files/onest-latin-wght-normal.woff2?url";
import "../styles/global.css";

interface Props {
  lang: "es" | "en";
  title: string;
  description: string;
  canonicalPath: string;
  alternatePath: string;
  image?: string;
  pageType?: "website" | "article";
  structuredData?: Record<string, unknown>;
}

const {
  lang,
  title,
  description,
  canonicalPath,
  alternatePath,
  image = lang === "es" ? "/og/portfolio-es.png" : "/og/portfolio-en.png",
  pageType = "website",
  structuredData,
} = Astro.props;

const site = Astro.site ?? new URL("https://rodrigorey.info");
const canonical = new URL(canonicalPath, site).toString();
const alternate = new URL(alternatePath, site).toString();
const ogImage = new URL(image, site).toString();
const homePath = getRelativeLocaleUrl(lang);
const isHome = canonicalPath === homePath || canonicalPath === `/${lang}`;
const fontFaceCss = `@font-face{font-family:'Onest Variable';font-style:normal;font-display:swap;font-weight:100 900;src:url('${onestLatinUrl}') format('woff2-variations')}`;
const copy = getSiteCopy(lang);
const personId = new URL("/#person", site).toString();
const person = {
  "@type": "Person",
  "@id": personId,
  name: "Rodrigo Rey",
  url: new URL(homePath, site).toString(),
  image: new URL("/rodrigo-rey.jpg", site).toString(),
  jobTitle: lang === "es" ? "Desarrollador web y de software" : "Web and software developer",
  description: copy.meta.description,
  address: { "@type": "PostalAddress", addressLocality: "Montevideo", addressCountry: "UY" },
  knowsAbout: [...copy.about.primaryTechnologies, ...copy.about.moreTechnologies],
  sameAs: ["https://github.com/RodReBer", "https://www.linkedin.com/in/rodrigorey2005/"],
};
// Home: Person + WebSite. Las páginas de proyecto pasan su propio
// structuredData y referencian a la persona por @id.
const homeSchema = {
  "@context": "https://schema.org",
  "@graph": [
    person,
    {
      "@type": "WebSite",
      "@id": new URL("/#website", site).toString(),
      url: site.toString(),
      name: "Rodrigo Rey",
      inLanguage: lang === "es" ? "es-UY" : "en-US",
      publisher: { "@id": personId },
    },
  ],
};
---

<!doctype html>
<html lang={lang} class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#08090D" />
    <meta name="description" content={description} />
    <link rel="preload" href={onestLatinUrl} as="font" type="font/woff2" crossorigin="anonymous" />
    <style is:inline set:html={fontFaceCss} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang={lang === "es" ? "en" : "es"} href={alternate} />
    <link rel="alternate" hreflang={lang} href={canonical} />
    <link rel="alternate" hreflang="x-default" href={new URL("/", site).toString()} />

    <meta property="og:locale" content={lang === "es" ? "es_UY" : "en_US"} />
    <meta property="og:type" content={pageType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData ?? homeSchema).replace(/</g, "\\u003c")} />
    <ClientRouter />
    <title>{title}</title>

    <script is:inline>
      function loadAnalytics() {
        if (window.__rrAnalyticsLoaded) return;
        window.__rrAnalyticsLoaded = true;
        const script = document.createElement("script");
        script.async = true;
        script.src = "https://www.googletagmanager.com/gtag/js?id=G-KCD3X6GB71";
        document.head.appendChild(script);
        window.dataLayer = window.dataLayer || [];
        // gtag.js sólo procesa objetos `arguments`: con (...args) se pushea un
        // Array común y Analytics ignora los comandos (no registraba visitas).
        // eslint-disable-next-line prefer-rest-params -- gtag.js exige `arguments`
        window.gtag = function () { window.dataLayer.push(arguments); };
        window.gtag("js", new Date());
        window.gtag("config", "G-KCD3X6GB71");
      }
      ["pointerdown", "keydown", "scroll"].forEach((eventName) => {
        window.addEventListener(eventName, loadAnalytics, { once: true, passive: true });
      });
      window.addEventListener("load", () => {
        window.setTimeout(() => {
          if ("requestIdleCallback" in window) window.requestIdleCallback(loadAnalytics, { timeout: 2000 });
          else loadAnalytics();
        }, 3000);
      }, { once: true });
    </script>
  </head>
  <body>
    <Header lang={lang} homePath={homePath} alternatePath={alternatePath} isHome={isHome} />
    <slot />
    <Footer lang={lang} homePath={homePath} />
  </body>
</html>

<style is:global>
  @keyframes rr-root-in {
    from { opacity: 0; }
    to { opacity: 1; }
  }
  @keyframes rr-root-out {
    from { opacity: 1; }
    to { opacity: 0; }
  }
  ::view-transition-old(root) { animation-name: rr-root-out; }
  ::view-transition-new(root) { animation-name: rr-root-in; }
</style>
