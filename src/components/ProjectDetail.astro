---
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "../layouts/Layout.astro";
import {
  getAdjacentProjects,
  getSiteCopy,
  type Lang,
  type LocalizedProject,
} from "../data/site";

interface Props {
  lang: Lang;
  project: LocalizedProject;
}

const { lang, project } = Astro.props;
const copy = getSiteCopy(lang);
const adjacent = getAdjacentProjects(lang, project.slug);
const alternateLang: Lang = lang === "es" ? "en" : "es";
const canonicalPath = project.href;
const alternatePath = getRelativeLocaleUrl(alternateLang, `projects/${project.slug}`);
const pageTitle = `${project.title} — Rodrigo Rey`;
const backHref = `${getRelativeLocaleUrl(lang)}#projects`;
const site = Astro.site ?? new URL("https://rodrigorey.info");
const structuredData = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: project.title,
  description: project.summary,
  image: new URL(project.image, site).toString(),
  url: new URL(canonicalPath, site).toString(),
  inLanguage: lang,
  about: {
    "@type": "WebSite",
    name: project.title,
    url: project.website,
  },
  author: {
    "@type": "Person",
    name: "Rodrigo Rey",
    url: new URL(getRelativeLocaleUrl(lang), site).toString(),
  },
};
---

<Layout
  lang={lang}
  title={pageTitle}
  description={project.summary}
  canonicalPath={canonicalPath}
  alternatePath={alternatePath}
  pageType="article"
  structuredData={structuredData}
>
  <main
    id="main-content"
    tabindex="-1"
    class="project-detail"
    style={`--project-accent: ${project.accent}`}
  >
    <article class="project-shell">
      <a class="back-link" href={backHref}>
        <svg aria-hidden="true" viewBox="0 0 24 24">
          <path d="m15 18-6-6 6-6"></path>
        </svg>
        {copy.projectDetail.back}
      </a>

      <header class="project-hero">
        <div class="project-kicker">
          <span class="face-grid" aria-hidden="true">
            {Array.from({ length: 9 }, (_, index) => <i data-index={index}></i>)}
          </span>
          <span>{copy.projectDetail.eyebrow}</span>
        </div>

        <div class="project-heading">
          <div>
            <h1 transition:name={`project-title-${project.slug}`}>
              {project.title}
            </h1>
            <p>{project.brand}{project.brandSecondary && ` · ${project.brandSecondary}`}</p>
          </div>

          <a
            class="website-link"
            href={project.website}
            target="_blank"
            rel="noopener noreferrer"
          >
            {copy.projectDetail.visitWebsite}
            <svg aria-hidden="true" viewBox="0 0 24 24">
              <path d="M7 17 17 7M8 7h9v9"></path>
            </svg>
          </a>
        </div>
      </header>

      <figure class="project-image-frame">
        <img
          src={project.image}
          alt={`${copy.projectDetail.imageAlt}: ${project.title}`}
          width="1280"
          height="720"
          loading="eager"
          decoding="async"
          fetchpriority="high"
          transition:name={`project-image-${project.slug}`}
        />
      </figure>

      <div class="project-information">
        <section aria-labelledby="overview-title">
          <p class="section-number" aria-hidden="true">01</p>
          <h2 id="overview-title">{copy.projectDetail.overview}</h2>
          <p class="project-summary">{project.summary}</p>
        </section>

        <section aria-labelledby="features-title">
          <p class="section-number" aria-hidden="true">02</p>
          <h2 id="features-title">{copy.projectDetail.features}</h2>
          <ul class="feature-list">
            {
              project.features.map((feature) => (
                <li>
                  <span aria-hidden="true"></span>
                  {feature}
                </li>
              ))
            }
          </ul>
        </section>
      </div>

      {
        adjacent && (
          <nav class="project-pagination" aria-label={copy.projects.title}>
            <a href={adjacent.previous.href} rel="prev">
              <img
                src={adjacent.previous.image}
                alt=""
                width="320"
                height="180"
                loading="lazy"
                decoding="async"
                transition:name={`project-image-${adjacent.previous.slug}`}
              />
              <span class="pagination-copy">
                <small>{copy.projectDetail.previous}</small>
                <strong transition:name={`project-title-${adjacent.previous.slug}`}>
                  {adjacent.previous.title}
                </strong>
              </span>
              <svg class="previous-arrow" aria-hidden="true" viewBox="0 0 24 24">
                <path d="m15 18-6-6 6-6"></path>
              </svg>
            </a>

            <a href={adjacent.next.href} rel="next">
              <img
                src={adjacent.next.image}
                alt=""
                width="320"
                height="180"
                loading="lazy"
                decoding="async"
                transition:name={`project-image-${adjacent.next.slug}`}
              />
              <span class="pagination-copy">
                <small>{copy.projectDetail.next}</small>
                <strong transition:name={`project-title-${adjacent.next.slug}`}>
                  {adjacent.next.title}
                </strong>
              </span>
              <svg aria-hidden="true" viewBox="0 0 24 24">
                <path d="m9 18 6-6-6-6"></path>
              </svg>
            </a>
          </nav>
        )
      }
    </article>
  </main>
</Layout>

<style>
  .project-detail {
    min-height: 100vh;
    background: #08090d;
    color: #f6f3ea;
    padding: 8.5rem 1.25rem 6rem;
  }

  .project-shell {
    width: min(100%, 74rem);
    margin-inline: auto;
  }

  .back-link,
  .website-link {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    border-radius: 0.7rem;
    font-weight: 650;
    text-decoration: none;
    transition:
      color 180ms ease,
      background-color 180ms ease,
      border-color 180ms ease,
      transform 180ms ease;
  }

  .back-link {
    color: #b9bbc3;
    padding: 0 0.75rem;
    margin-left: -0.75rem;
  }

  .back-link:hover {
    color: #f6f3ea;
    background: #1a1d24;
  }

  .back-link svg,
  .website-link svg,
  .project-pagination svg {
    width: 1.25rem;
    height: 1.25rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .project-hero {
    padding-block: clamp(3rem, 8vw, 6.5rem) clamp(2.5rem, 6vw, 4rem);
  }

  .project-kicker {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    margin-bottom: 1.5rem;
    color: #b9bbc3;
    font-size: 0.78rem;
    font-weight: 750;
    letter-spacing: 0.13em;
    text-transform: uppercase;
  }

  .face-grid {
    display: grid;
    grid-template-columns: repeat(3, 0.3rem);
    gap: 0.12rem;
    padding: 0.2rem;
    border-radius: 0.2rem;
    background: #08090d;
    box-shadow: 0 0 0 1px #32353e;
  }

  .face-grid i {
    width: 0.3rem;
    aspect-ratio: 1;
    border-radius: 0.05rem;
    background: var(--project-accent);
  }

  .project-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 2rem;
  }

  h1 {
    max-width: 14ch;
    margin: 0;
    font-size: clamp(3rem, 8vw, 7.25rem);
    font-weight: 780;
    letter-spacing: -0.055em;
    line-height: 0.91;
    text-wrap: balance;
  }

  .project-heading p {
    margin: 1.25rem 0 0;
    color: #92959f;
    font-size: 1rem;
  }

  .website-link {
    flex: none;
    border: 1px solid color-mix(in srgb, var(--project-accent) 65%, #32353e);
    background: color-mix(in srgb, var(--project-accent) 12%, transparent);
    color: #f6f3ea;
    padding: 0.8rem 1rem;
  }

  .website-link:hover {
    border-color: var(--project-accent);
    background: color-mix(in srgb, var(--project-accent) 20%, transparent);
    transform: translateY(-2px);
  }

  .project-image-frame {
    position: relative;
    overflow: hidden;
    margin: 0;
    padding: clamp(0.35rem, 1vw, 0.65rem);
    border: 1px solid #32353e;
    border-radius: clamp(1rem, 2vw, 1.5rem);
    background: #12141a;
    box-shadow: 0 2rem 5rem rgba(0, 0, 0, 0.36);
  }

  .project-image-frame::before {
    position: absolute;
    z-index: 1;
    inset: 0;
    border-top: 2px solid var(--project-accent);
    border-radius: inherit;
    content: "";
    pointer-events: none;
  }

  .project-image-frame img {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    border-radius: calc(clamp(1rem, 2vw, 1.5rem) - 0.35rem);
    object-fit: cover;
  }

  .project-information {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(17rem, 0.8fr);
    gap: clamp(2.5rem, 7vw, 7rem);
    padding-block: clamp(4rem, 8vw, 7rem);
  }

  .project-information section {
    border-top: 1px solid #32353e;
    padding-top: 1.25rem;
  }

  .section-number {
    margin: 0 0 1.5rem;
    color: color-mix(in srgb, var(--project-accent) 52%, #f6f3ea);
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.75rem;
  }

  h2 {
    margin: 0 0 1.25rem;
    font-size: clamp(1.35rem, 3vw, 2rem);
    letter-spacing: -0.025em;
  }

  .project-summary {
    max-width: 45rem;
    margin: 0;
    color: #c7c8ce;
    font-size: clamp(1.05rem, 2vw, 1.3rem);
    line-height: 1.7;
  }

  .feature-list {
    display: grid;
    gap: 1rem;
    margin: 0;
    padding: 0;
    color: #c7c8ce;
    list-style: none;
  }

  .feature-list li {
    display: grid;
    grid-template-columns: 0.65rem 1fr;
    align-items: start;
    gap: 0.8rem;
    line-height: 1.55;
  }

  .feature-list li span {
    width: 0.65rem;
    aspect-ratio: 1;
    margin-top: 0.4rem;
    border: 2px solid #08090d;
    border-radius: 0.12rem;
    outline: 1px solid #32353e;
    background: var(--project-accent);
  }

  .project-pagination {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
    padding-top: 1.5rem;
    border-top: 1px solid #32353e;
  }

  .project-pagination a {
    display: grid;
    grid-template-columns: 5rem minmax(0, 1fr) auto;
    align-items: center;
    gap: 1rem;
    min-height: 6.5rem;
    padding: 0.75rem;
    border: 1px solid #292c34;
    border-radius: 1rem;
    background: #12141a;
    color: #f6f3ea;
    text-decoration: none;
    transition:
      border-color 180ms ease,
      background-color 180ms ease,
      transform 180ms ease;
  }

  .project-pagination a:hover {
    border-color: #4b4f59;
    background: #1a1d24;
    transform: translateY(-2px);
  }

  .project-pagination img {
    width: 5rem;
    aspect-ratio: 16 / 10;
    border-radius: 0.6rem;
    object-fit: cover;
  }

  .pagination-copy {
    display: grid;
    gap: 0.25rem;
    min-width: 0;
  }

  .pagination-copy small {
    color: #92959f;
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .pagination-copy strong {
    overflow: hidden;
    font-size: clamp(0.95rem, 2vw, 1.15rem);
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .previous-arrow {
    order: -1;
  }

  .project-pagination a:first-child {
    grid-template-columns: auto 5rem minmax(0, 1fr);
  }

  .project-pagination a:first-child img {
    order: 0;
  }

  .project-pagination a:first-child .pagination-copy {
    order: 1;
  }

  :is(.back-link, .website-link, .project-pagination a):focus-visible {
    outline: 3px solid #ffd500;
    outline-offset: 4px;
  }

  @media (max-width: 47.99rem) {
    .project-detail {
      padding: 7.25rem 1rem 4rem;
    }

    .project-heading {
      align-items: start;
      flex-direction: column;
    }

    .website-link {
      width: 100%;
    }

    .project-information,
    .project-pagination {
      grid-template-columns: 1fr;
    }

    .project-information {
      gap: 3rem;
    }

    .project-pagination a {
      grid-template-columns: 4.5rem minmax(0, 1fr) auto;
    }

    .project-pagination a:first-child {
      grid-template-columns: auto 4.5rem minmax(0, 1fr);
    }

    .project-pagination img {
      width: 4.5rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .back-link,
    .website-link,
    .project-pagination a {
      transition-duration: 0.01ms;
    }
  }
</style>
