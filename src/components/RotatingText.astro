<div
  class="absolute inset-0 flex items-center justify-center animate-spin-slow pointer-events-none overflow-visible z-20"
>
  <svg
    viewBox="0 0 100 100"
    width="100%"
    height="100%"
    class="overflow-visible"
  >
    <defs>
      <path
        id="circle"
        d="M 50, 50 m -37, 0 a 37,37 0 1,1 74,0 a 37,37 0 1,1 -74,0"></path>
    </defs>
    <text
      font-size="8.5"
      fill="currentColor"
      class="text-cyan-400 font-mono tracking-widest uppercase"
    >
      <textPath xlink:href="#circle">
        Web Developer • Software Developer •
      </textPath>
    </text>
  </svg>
</div>

<style>
  .animate-spin-slow {
    animation: spin 15s linear infinite;
  }

  @keyframes spin {
    from {
      transform: rotate(0deg);
    }
    to {
      transform: rotate(360deg);
    }
  }
</style>
