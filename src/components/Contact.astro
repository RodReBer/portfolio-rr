---
import { PUBLIC_RECAPTCHA_SITE_KEY } from "astro:env/client";
import type { Lang, SiteCopy } from "../data/site";

interface Props {
  lang?: Lang;
  copy: SiteCopy["contact"];
}

const { lang = "es", copy } = Astro.props;
const strings = copy; // el markup de abajo usa `strings.*`
const recaptchaSiteKey = PUBLIC_RECAPTCHA_SITE_KEY ?? "";
const suffix = `contact-${lang}`;

// Solo los textos que necesita el <script> del cliente (se pasan como JSON).
const clientCopy = {
  submit: copy.submit,
  sending: copy.sending,
  success: copy.success,
  errorRequired: copy.errorRequired,
  errorTooShort: copy.errorTooShort,
  errorEmail: copy.errorEmail,
  errorGeneric: copy.errorGeneric,
  errorRecaptcha: copy.errorRecaptcha,
};
---

<form
    class="contact-form"
    id={`${suffix}-form`}
    action="/api/contact"
    method="post"
    novalidate
    data-contact-form
    data-copy={JSON.stringify(clientCopy)}
    data-site-key={recaptchaSiteKey}
  >
    <input type="hidden" name="recaptcha_token" data-contact-token />
    <input type="hidden" name="lang" value={lang} />

    <p
      class="contact-status"
      data-contact-status
      role="status"
      aria-live="polite"
      aria-atomic="true"
      hidden
    ></p>

    <div class="form-cube-header" aria-hidden="true">
      <div class="turn-sequence">
        <span>D</span>
        <code>ALG 01 · R U R&#8242; U&#8242;</code>
      </div>
      <div class="contact-face">
        {Array.from({ length: 9 }, (_, index) => <i class:list={{ "is-center": index === 4 }}></i>)}
      </div>
    </div>

    <div class="contact-fields">
      <div class="contact-field">
        <label for={`${suffix}-name`}><span aria-hidden="true">01</span>{strings.nameLabel}</label>
        <input
          id={`${suffix}-name`}
          name="name"
          type="text"
          autocomplete="name"
          placeholder={strings.namePlaceholder}
          minlength="2"
          maxlength="80"
          aria-describedby={`${suffix}-name-error`}
          aria-errormessage={`${suffix}-name-error`}
          required
        />
        <p class="contact-error" id={`${suffix}-name-error`} data-error-for="name" hidden></p>
      </div>

      <div class="contact-field">
        <label for={`${suffix}-email`}><span aria-hidden="true">02</span>{strings.emailLabel}</label>
        <input
          id={`${suffix}-email`}
          name="email"
          type="email"
          inputmode="email"
          autocomplete="email"
          placeholder={strings.emailPlaceholder}
          maxlength="254"
          aria-describedby={`${suffix}-email-error`}
          aria-errormessage={`${suffix}-email-error`}
          required
        />
        <p class="contact-error" id={`${suffix}-email-error`} data-error-for="email" hidden></p>
      </div>

      <div class="contact-field contact-field-wide">
        <label for={`${suffix}-subject`}><span aria-hidden="true">03</span>{strings.subjectLabel}</label>
        <input
          id={`${suffix}-subject`}
          name="subject"
          type="text"
          autocomplete="off"
          placeholder={strings.subjectPlaceholder}
          minlength="3"
          maxlength="120"
          aria-describedby={`${suffix}-subject-error`}
          aria-errormessage={`${suffix}-subject-error`}
          required
        />
        <p class="contact-error" id={`${suffix}-subject-error`} data-error-for="subject" hidden></p>
      </div>

      <div class="contact-field contact-field-wide">
        <label for={`${suffix}-message`}><span aria-hidden="true">04</span>{strings.messageLabel}</label>
        <textarea
          id={`${suffix}-message`}
          name="message"
          placeholder={strings.messagePlaceholder}
          rows="6"
          minlength="10"
          maxlength="5000"
          aria-describedby={`${suffix}-message-error`}
          aria-errormessage={`${suffix}-message-error`}
          required
        ></textarea>
        <p class="contact-error" id={`${suffix}-message-error`} data-error-for="message" hidden></p>
      </div>
    </div>

    <button class="contact-submit" type="submit" data-contact-submit>
      <span data-submit-label>{strings.submit}</span>
      <svg aria-hidden="true" viewBox="0 0 24 24">
        <path d="m5 12 14-7-4 14-3-6-7-1Z"></path>
      </svg>
    </button>
</form>

<script>
  type ContactField = "name" | "email" | "subject" | "message";
  type FieldInput = HTMLInputElement | HTMLTextAreaElement;
  type ClientCopy = {
    submit: string;
    sending: string;
    success: string;
    errorRequired: string;
    errorTooShort: string;
    errorEmail: string;
    errorGeneric: string;
    errorRecaptcha: string;
  };
  type ApiResponse = { ok?: boolean };
  interface RecaptchaApi {
    ready(callback: () => void): void;
    execute(siteKey: string, options: { action: string }): Promise<string>;
  }

  const FIELDS: ContactField[] = ["name", "email", "subject", "message"];
  const recaptchaWindow = window as Window & {
    grecaptcha?: RecaptchaApi;
    __contactRecaptchaPromise?: Promise<RecaptchaApi>;
  };

  // Carga el script de reCAPTCHA v3 una sola vez y devuelve su API.
  function loadRecaptcha(siteKey: string): Promise<RecaptchaApi> {
    if (recaptchaWindow.__contactRecaptchaPromise) {
      return recaptchaWindow.__contactRecaptchaPromise;
    }

    recaptchaWindow.__contactRecaptchaPromise = new Promise<RecaptchaApi>((resolve, reject) => {
      const timeout = window.setTimeout(
        () => reject(new Error("reCAPTCHA timed out")),
        8_000,
      );
      const fail = (message: string) => {
        window.clearTimeout(timeout);
        reject(new Error(message));
      };
      const ready = () => {
        const api = recaptchaWindow.grecaptcha;
        if (!api) {
          fail("reCAPTCHA unavailable");
          return;
        }
        api.ready(() => {
          window.clearTimeout(timeout);
          resolve(api);
        });
      };

      const existing = document.querySelector<HTMLScriptElement>(
        "script[data-contact-recaptcha]",
      );
      if (existing) {
        if (recaptchaWindow.grecaptcha) ready();
        else {
          existing.addEventListener("load", ready, { once: true });
          existing.addEventListener(
            "error",
            () => fail("reCAPTCHA failed to load"),
            { once: true },
          );
        }
        return;
      }

      const script = document.createElement("script");
      script.src = `https://www.google.com/recaptcha/api.js?render=${encodeURIComponent(siteKey)}`;
      script.async = true;
      script.defer = true;
      script.dataset.contactRecaptcha = "";
      script.addEventListener("load", ready, { once: true });
      script.addEventListener(
        "error",
        () => fail("reCAPTCHA failed to load"),
        { once: true },
      );
      document.head.append(script);
    }).catch((error: unknown) => {
      recaptchaWindow.__contactRecaptchaPromise = undefined;
      document.querySelector("script[data-contact-recaptcha]")?.remove();
      throw error;
    });

    return recaptchaWindow.__contactRecaptchaPromise;
  }

  function initContactForm(form: HTMLFormElement): void {
    if (form.dataset.contactBound === "true") return;
    form.dataset.contactBound = "true";

    const copy = JSON.parse(form.dataset.copy ?? "{}") as ClientCopy;
    const siteKey = form.dataset.siteKey ?? "";
    const status = form.querySelector<HTMLElement>("[data-contact-status]");
    const submit = form.querySelector<HTMLButtonElement>("[data-contact-submit]");
    const submitLabel = form.querySelector<HTMLElement>("[data-submit-label]");
    const tokenField = form.querySelector<HTMLInputElement>("[data-contact-token]");
    const controller = new AbortController();
    const { signal } = controller;

    if (!status || !submit || !submitLabel || !tokenField) return;

    const inputFor = (field: ContactField) =>
      form.elements.namedItem(field) as FieldInput | null;
    const errorFor = (field: ContactField) =>
      form.querySelector<HTMLElement>(`[data-error-for="${field}"]`);

    function clearStatus(): void {
      status!.hidden = true;
      status!.textContent = "";
      delete status!.dataset.kind;
    }

    function showStatus(message: string, kind: "success" | "error"): void {
      status!.textContent = message;
      status!.dataset.kind = kind;
      status!.hidden = false;
      status!.setAttribute("role", kind === "error" ? "alert" : "status");
    }

    function clearFieldError(field: ContactField): void {
      inputFor(field)?.removeAttribute("aria-invalid");
      const error = errorFor(field);
      if (error) {
        error.textContent = "";
        error.hidden = true;
      }
    }

    function showFieldError(field: ContactField, message: string): void {
      inputFor(field)?.setAttribute("aria-invalid", "true");
      const error = errorFor(field);
      if (error) {
        error.textContent = message;
        error.hidden = false;
      }
    }

    // Traduce el error de la validación nativa del navegador a un mensaje del copy.
    function messageForInput(input: FieldInput): string {
      if (input.validity.valueMissing) return copy.errorRequired;
      if (input.validity.typeMismatch) return copy.errorEmail;
      if (input.validity.tooShort) return copy.errorTooShort;
      return copy.errorGeneric;
    }

    function validateField(field: ContactField): boolean {
      const input = inputFor(field);
      if (!input) return false;
      clearFieldError(field);
      if (input.checkValidity()) return true;
      showFieldError(field, messageForInput(input));
      return false;
    }

    function validateAll(): boolean {
      let firstInvalid: FieldInput | null = null;
      for (const field of FIELDS) {
        if (!validateField(field) && !firstInvalid) firstInvalid = inputFor(field);
      }
      firstInvalid?.focus();
      return firstInvalid === null;
    }

    // Empieza a cargar reCAPTCHA en cuanto el visitante toca un campo.
    form.addEventListener(
      "focusin",
      (event) => {
        if (!siteKey || !(event.target instanceof Element)) return;
        if (event.target.matches("input:not([type='hidden']), textarea")) {
          void loadRecaptcha(siteKey).catch(() => undefined);
        }
      },
      { signal },
    );

    form.addEventListener(
      "input",
      (event) => {
        const target = event.target;
        if (
          (target instanceof HTMLInputElement || target instanceof HTMLTextAreaElement) &&
          FIELDS.includes(target.name as ContactField)
        ) {
          clearFieldError(target.name as ContactField);
          clearStatus();
        }
      },
      { signal },
    );

    form.addEventListener(
      "focusout",
      (event) => {
        const target = event.target;
        if (
          (target instanceof HTMLInputElement || target instanceof HTMLTextAreaElement) &&
          FIELDS.includes(target.name as ContactField) &&
          target.value.length > 0
        ) {
          validateField(target.name as ContactField);
        }
      },
      { signal },
    );

    form.addEventListener(
      "submit",
      async (event) => {
        event.preventDefault();
        clearStatus();
        if (!validateAll()) return;

        submit.disabled = true;
        submit.setAttribute("aria-busy", "true");
        submitLabel.textContent = copy.sending;

        try {
          tokenField.value = "";
          if (siteKey) {
            const recaptcha = await loadRecaptcha(siteKey);
            tokenField.value = await recaptcha.execute(siteKey, { action: "contact" });
          }
          if (signal.aborted) return;

          const response = await fetch(form.action, {
            method: "POST",
            body: new FormData(form),
            headers: { Accept: "application/json" },
            signal,
          });
          const result = (await response.json().catch(() => null)) as ApiResponse | null;

          if (response.ok && result?.ok) {
            form.reset();
            FIELDS.forEach(clearFieldError);
            showStatus(copy.success, "success");
            return;
          }

          showStatus(copy.errorGeneric, "error");
        } catch (error) {
          if (signal.aborted) return;
          const isRecaptchaError =
            error instanceof Error && error.message.includes("reCAPTCHA");
          showStatus(isRecaptchaError ? copy.errorRecaptcha : copy.errorGeneric, "error");
        } finally {
          if (!signal.aborted) {
            submit.disabled = false;
            submit.removeAttribute("aria-busy");
            submitLabel.textContent = copy.submit;
          }
        }
      },
      { signal },
    );

    document.addEventListener("astro:before-swap", () => controller.abort(), {
      once: true,
      signal,
    });
  }

  function initContactForms(): void {
    document
      .querySelectorAll<HTMLFormElement>("[data-contact-form]")
      .forEach(initContactForm);
  }

  initContactForms();
  document.addEventListener("astro:page-load", initContactForms);
</script>

<style>
  .contact-form {
    position: relative;
    z-index: 1;
    width: 100%;
  }

  .form-cube-header {
    display: flex;
    min-height: 3.25rem;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.25rem;
    border-bottom: 4px solid var(--rubik-joint, #050609);
    padding: 0 0 .9rem;
  }

  .turn-sequence {
    display: flex;
    align-items: center;
    gap: .7rem;
    color: var(--color-muted, #a9afba);
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: .7rem;
    letter-spacing: .12em;
  }

  .turn-sequence span {
    display: grid;
    width: 2rem;
    height: 2rem;
    place-items: center;
    border: 3px solid var(--rubik-joint, #050609);
    border-radius: .3rem;
    background: var(--rubik-yellow, #ffd500);
    box-shadow: 0 0 0 1px rgb(255 213 0 / .55), inset 0 1px 0 rgb(255 255 255 / .32);
    color: #08090d;
    font-weight: 900;
  }

  .turn-sequence code { font: inherit; }

  .contact-face {
    display: grid;
    width: 2.55rem;
    height: 2.55rem;
    flex: none;
    grid-template-columns: repeat(3, 1fr);
    gap: 2px;
    border: 3px solid var(--rubik-joint, #050609);
    border-radius: .3rem;
    padding: 2px;
    background: var(--rubik-joint, #050609);
    rotate: 5deg;
  }

  .contact-face i {
    border-radius: 1px;
    background: #474b54;
    box-shadow: inset 0 1px 0 rgb(255 255 255 / .08);
  }

  .contact-face .is-center { background: var(--rubik-yellow, #ffd500); }

  .contact-fields {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.2rem;
  }

  .contact-field {
    position: relative;
    min-width: 0;
    border: 1px solid var(--color-border, #343842);
    border-radius: .48rem;
    padding: .72rem;
    background: linear-gradient(145deg, rgb(18 20 26 / .98), rgb(10 11 15 / .98));
    box-shadow: 0 0 0 3px var(--rubik-joint, #050609), inset 0 1px 0 rgb(255 255 255 / .035);
    transition: border-color var(--motion-fast, 180ms) ease, translate var(--motion-fast, 180ms) var(--ease-snap, ease);
  }

  .contact-field:focus-within {
    border-color: rgb(255 213 0 / .68);
    translate: 0 -2px;
  }

  .contact-field-wide { grid-column: 1 / -1; }

  .contact-field label {
    display: flex;
    align-items: center;
    gap: .55rem;
    margin: 0 0 0.55rem;
    color: var(--color-ink, #f6f3ea);
    font-size: 0.82rem;
    font-weight: 650;
    letter-spacing: 0.02em;
  }

  .contact-field label span {
    color: var(--rubik-yellow, #ffd500);
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: .62rem;
    letter-spacing: .08em;
  }

  .contact-field input,
  .contact-field textarea {
    width: 100%;
    min-height: 3rem;
    box-sizing: border-box;
    border: 1px solid var(--color-border, #343842);
    border-radius: 0.34rem;
    outline: none;
    background: #08090d;
    color: var(--color-ink, #f6f3ea);
    font: inherit;
    font-size: 0.95rem;
    line-height: 1.5;
    padding: 0.78rem 0.9rem;
    transition:
      border-color var(--motion-fast, 180ms) ease,
      box-shadow var(--motion-fast, 180ms) ease,
      background-color var(--motion-fast, 180ms) ease;
  }

  .contact-field textarea {
    min-height: 9.5rem;
    resize: vertical;
  }

  .contact-field input::placeholder,
  .contact-field textarea::placeholder {
    color: #777d88;
    opacity: 1;
  }

  .contact-field input:hover,
  .contact-field textarea:hover { border-color: #555b66; }

  .contact-field input:focus-visible,
  .contact-field textarea:focus-visible {
    border-color: var(--section-accent, var(--rubik-yellow, #ffd500));
    outline: 3px solid var(--rubik-yellow, #ffd500);
    outline-offset: 3px;
    box-shadow: 0 0 0 3px rgb(255 213 0 / 0.18);
  }

  .contact-field input[aria-invalid="true"],
  .contact-field textarea[aria-invalid="true"] {
    border-color: #ef5b5b;
    box-shadow: 0 0 0 3px rgb(239 91 91 / 0.13);
  }

  .contact-error {
    margin: 0.42rem 0 0;
    color: #ff8c8c;
    font-size: 0.78rem;
    line-height: 1.45;
  }

  .contact-status {
    margin: 0 0 1.25rem;
    border: 1px solid;
    border-radius: 0.42rem;
    padding: 0.85rem 1rem;
    font-size: 0.875rem;
    line-height: 1.5;
  }

  .contact-status[data-kind="success"] {
    border-color: rgb(0 185 107 / 0.45);
    background: rgb(0 155 90 / 0.13);
    color: #8ce9c1;
  }

  .contact-status[data-kind="error"] {
    border-color: rgb(239 91 91 / 0.45);
    background: rgb(215 44 44 / 0.12);
    color: #ffaaaa;
  }

  .contact-submit {
    display: inline-flex;
    min-height: 2.9rem;
    align-items: center;
    justify-content: center;
    gap: 0.65rem;
    margin-top: 1.5rem;
    border: 1px solid var(--section-accent, var(--rubik-yellow, #ffd500));
    border-radius: 0.38rem;
    background: var(--section-accent, var(--rubik-yellow, #ffd500));
    box-shadow:
      0 0 0 3px var(--rubik-joint, #050609),
      0 10px 30px rgb(255 213 0 / 0.14),
      inset 0 1px 0 rgb(255 255 255 / 0.36);
    color: var(--color-canvas, #08090d);
    cursor: pointer;
    font: inherit;
    font-size: 0.9rem;
    font-weight: 750;
    padding: 0.75rem 1.15rem;
    transition:
      translate var(--motion-fast, 180ms) ease,
      filter var(--motion-fast, 180ms) ease,
      box-shadow var(--motion-fast, 180ms) ease;
  }

  .contact-submit:hover:not(:disabled) {
    translate: 0 -2px;
    filter: brightness(1.08);
    box-shadow:
      0 0 0 3px var(--rubik-joint, #050609),
      0 13px 34px rgb(255 213 0 / 0.2),
      inset 0 1px 0 rgb(255 255 255 / 0.36);
  }

  .contact-submit:focus-visible {
    outline: 3px solid #f6f3ea;
    outline-offset: 3px;
  }

  .contact-submit:disabled {
    cursor: wait;
    opacity: 0.62;
  }

  .contact-submit svg {
    width: 1rem;
    height: 1rem;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.8;
  }

  [hidden] { display: none !important; }

  @media (max-width: 540px) {
    .contact-fields { grid-template-columns: 1fr; }
    .contact-field-wide { grid-column: auto; }
    .contact-submit { width: 100%; }
  }

  @media (prefers-reduced-motion: reduce) {
    .contact-field { transition-duration: 0.01ms; }
    .contact-field:focus-within { translate: 0; }
    .contact-field input,
    .contact-field textarea,
    .contact-submit { transition-duration: 0.01ms; }
    .contact-submit:hover:not(:disabled) { translate: 0; }
  }
</style>
