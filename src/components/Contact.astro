---
const recaptchaSiteKey = import.meta.env.PUBLIC_RECAPTCHA_SITE_KEY ?? "";
---

<form class="max-w-md mx-auto" name="form" id="contact-form">
  <!-- Honeypot anti-spam -->
  <input
    type="text"
    name="_hp_trap"
    style="position: absolute; left: -9999px;"
    tabindex="-1"
    autocomplete="off"
    aria-hidden="true"
  />
  <input type="hidden" name="timestamp" id="timestamp_field" />
  <input type="hidden" name="recaptcha_token" id="recaptcha_token" />

  <!-- Pasa la site key al DOM para que el script procesado la lea -->
  <span id="recaptcha-config" data-key={recaptchaSiteKey} hidden></span>

  <!-- Messages Container -->
  <div id="form-messages" class="mb-4 hidden rounded-md p-4"></div>

  <!-- Campo Nombre -->
  <div class="relative z-0 w-full mb-5 group">
    <input
      type="text"
      name="Name"
      id="Name"
      class="block py-2.5 px-0 w-full text-sm text-gray-900 bg-transparent border-0 border-b-2 border-gray-300 appearance-none dark:text-white dark:border-gray-600 dark:focus:border-orange-500 focus:outline-none focus:ring-0 focus:border-violet-600 peer"
      placeholder=" "
      required
      minlength="2"
    />
    <label
      for="Name"
      data-i18n="contact.name"
      class="peer-focus:font-medium absolute text-sm text-gray-500 dark:text-gray-400 duration-300 transform -translate-y-6 scale-75 top-3 -z-10 origin-[0] peer-focus:start-0 rtl:peer-focus:translate-x-1/4 peer-focus:left-auto peer-focus:text-violet-600 peer-focus:dark:text-orange-500 peer-placeholder-shown:scale-100 peer-placeholder-shown:translate-y-0 peer-focus:scale-75 peer-focus:-translate-y-6"
    >
      Name
    </label>
  </div>

  <!-- Campo Email -->
  <div class="relative z-0 w-full mb-5 group">
    <input
      type="email"
      name="Email"
      id="Email"
      class="block py-2.5 px-0 w-full text-sm text-gray-900 bg-transparent border-0 border-b-2 border-gray-300 appearance-none dark:text-white dark:border-gray-600 dark:focus:border-orange-500 focus:outline-none focus:ring-0 focus:border-violet-600 peer"
      placeholder=" "
      required
    />
    <label
      for="Email"
      class="peer-focus:font-medium absolute text-sm text-gray-500 dark:text-gray-400 duration-300 transform -translate-y-6 scale-75 top-3 -z-10 origin-[0] peer-focus:start-0 rtl:peer-focus:translate-x-1/4 peer-focus:left-auto peer-focus:text-violet-600 peer-focus:dark:text-orange-500 peer-placeholder-shown:scale-100 peer-placeholder-shown:translate-y-0 peer-focus:scale-75 peer-focus:-translate-y-6"
    >
      Email
    </label>
  </div>

  <!-- Campo Asunto -->
  <div class="relative z-0 w-full mb-5 group">
    <input
      type="text"
      name="Subject"
      id="Subject"
      class="block py-2.5 px-0 w-full text-sm text-gray-900 bg-transparent border-0 border-b-2 border-gray-300 appearance-none dark:text-white dark:border-gray-600 dark:focus:border-orange-500 focus:outline-none focus:ring-0 focus:border-violet-600 peer"
      placeholder=" "
      required
      minlength="3"
    />
    <label
      for="Subject"
      data-i18n="contact.subject"
      class="peer-focus:font-medium absolute text-sm text-gray-500 dark:text-gray-400 duration-300 transform -translate-y-6 scale-75 top-3 -z-10 origin-[0] peer-focus:start-0 rtl:peer-focus:translate-x-1/4 peer-focus:left-auto peer-focus:text-violet-600 peer-focus:dark:text-orange-500 peer-placeholder-shown:scale-100 peer-placeholder-shown:translate-y-0 peer-focus:scale-75 peer-focus:-translate-y-6"
    >
      Subject
    </label>
  </div>

  <!-- Campo Mensaje -->
  <div class="relative z-0 w-full mb-5 group">
    <textarea
      name="Message"
      id="Message"
      class="block py-2.5 px-0 w-full text-sm text-gray-900 bg-transparent border-0 border-b-2 border-gray-300 appearance-none dark:text-white dark:border-gray-600 dark:focus:border-orange-500 focus:outline-none focus:ring-0 focus:border-violet-600 peer min-h-20"
      placeholder=" "
      required
      minlength="10"></textarea>
    <label
      for="Message"
      data-i18n="contact.message"
      class="peer-focus:font-medium absolute text-sm text-gray-500 dark:text-gray-400 duration-300 transform -translate-y-6 scale-75 top-3 -z-10 origin-[0] peer-focus:start-0 rtl:peer-focus:translate-x-1/4 peer-focus:left-auto peer-focus:text-violet-600 peer-focus:dark:text-orange-500 peer-placeholder-shown:scale-100 peer-placeholder-shown:translate-y-0 peer-focus:scale-75 peer-focus:-translate-y-6"
    >
      Message
    </label>
  </div>

  <!-- Botón de envío -->
  <button
    type="submit"
    id="submit-btn"
    data-i18n="contact.send"
    class="text-white bg-violet-700 hover:bg-violet-800 focus:ring-4 focus:outline-none focus:ring-violet-300 font-medium rounded-lg text-sm w-full sm:w-auto px-5 py-2.5 text-center dark:bg-orange-600 dark:hover:bg-orange-700 dark:focus:ring-orange-800 disabled:opacity-50 disabled:cursor-not-allowed"
  >
    Send message
  </button>
</form>

<script>
  const t = (key: string) => (window as any).__i18n?.t(key) ?? key;

  // ---- Form logic ----
  const SITE_KEY =
    (document.getElementById("recaptcha-config") as HTMLElement)?.dataset
      .key ?? "";

  const recaptchaReady = new Promise<void>((resolve, reject) => {
    const rcScript = document.createElement("script");
    rcScript.src = `https://www.google.com/recaptcha/api.js?render=${SITE_KEY}`;
    rcScript.onload = () => (window as any).grecaptcha.ready(resolve);
    rcScript.onerror = () => rejet(new Error("Failed to load reCAPTCHA"));
    document.head.appendChild(rcScript);
  });

  const form = document.getElementById("contact-form") as HTMLFormElement;
  const messagesDiv = document.getElementById("form-messages");
  const submitBtn = document.getElementById("submit-btn") as HTMLButtonElement;
  const timestampField = document.getElementById(
    "timestamp_field",
  ) as HTMLInputElement;
  const recaptchaTokenField = document.getElementById(
    "recaptcha_token",
  ) as HTMLInputElement;

  if (timestampField) {
    timestampField.value = Date.now().toString();
  }

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();

    if (!messagesDiv || !submitBtn) return;

    messagesDiv.style.display = "none";
    messagesDiv.className = "mb-4 hidden rounded-md p-4";
    submitBtn.disabled = true;
    submitBtn.innerText = t("contact.sending");

    try {
      await recaptchaReady;

      const token = await (window as any).grecaptcha.execute(SITE_KEY, {
        action: "contact",
      });

      if (recaptchaTokenField) {
        recaptchaTokenField.value = token;
      }

      const formData = new FormData(form);

      const response = await fetch("/api/contact", {
        method: "POST",
        body: formData,
      });

      const result = await response.json();

      if (response.ok) {
        messagesDiv.innerText = t("contact.success");
        messagesDiv.classList.remove("hidden");
        messagesDiv.classList.add("bg-green-100", "text-green-700", "block");
        form.reset();
        if (timestampField) timestampField.value = Date.now().toString();
      } else {
        throw new Error(result.message || t("contact.error"));
      }
    } catch (error) {
      messagesDiv.innerText =
        error instanceof Error ? error.message : t("contact.error");
      messagesDiv.classList.remove("hidden");
      messagesDiv.classList.add("bg-red-100", "text-red-700", "block");
    } finally {
      submitBtn.disabled = false;
      submitBtn.innerText = t("contact.send");
    }
  });
</script>
