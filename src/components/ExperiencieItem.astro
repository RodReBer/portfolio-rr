---
export interface Props {
  title?: string;
  titleKey?: string;
  description?: string;
  descriptionKey?: string;
  link?: string;
  date?: string;
  dateKey?: string;
  textLink?: string;
  current?: boolean;
  startDate?: string;
}

const {
  title,
  titleKey,
  description,
  descriptionKey,
  link,
  date,
  dateKey,
  textLink,
  current = false,
  startDate,
} = Astro.props;
---

<!-- Timeline dot with glow for current -->
<div
  class={`absolute w-3 h-3 rounded-full -start-[7px] border-2 ${
    current
      ? "bg-cyan-400 border-cyan-400 shadow-[0_0_10px_rgba(34,211,238,0.5)]"
      : "bg-slate-700 border-cyan-400/50"
  }`}
>
</div>

<!-- Date badge + duration -->
<div class="flex items-center gap-2 mb-2 flex-wrap">
  <span
    class={`inline-flex items-center px-3 py-1 text-xs font-medium rounded-full ${
      current ? "bg-cyan-400/20 text-cyan-400" : "bg-white/5 text-gray-400"
    }`}
  >
    {
      current && (
        <span class="w-1.5 h-1.5 bg-cyan-400 rounded-full mr-2 animate-pulse" />
      )
    }
    <span data-i18n={dateKey}>{date}</span>
  </span>
  {
    startDate && (
      <span
        class="duration-badge px-3 py-1 text-xs font-medium rounded-full bg-white/5 text-gray-500"
        data-start-date={startDate}
      />
    )
  }
</div>

<!-- Title -->
<h3
  class="text-lg font-semibold text-white mt-1"
  data-i18n={titleKey}
>
  {title}
</h3>

<!-- Description -->
<p
  class="mb-4 text-sm text-gray-400 text-pretty leading-relaxed"
  data-i18n={descriptionKey}
>
  {description}
</p>

<!-- Link button -->
{
  link && (
    <a
      href={link}
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex items-center gap-2 px-4 py-2 text-sm font-medium rounded-lg bg-cyan-500/10 text-cyan-400 border border-cyan-500/20 hover:bg-cyan-500/20 transition-all duration-300"
    >
      {textLink}
      <svg
        class="w-4 h-4"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M14 5l7 7m0 0l-7 7m7-7H3"
        />
      </svg>
    </a>
  )
}
