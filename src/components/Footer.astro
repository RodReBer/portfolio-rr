---
import GitHubIcon from "./icons/GithubFooter.astro";
import LinkedInIcon from "./icons/LinkedIn.astro";
import YouTubeIcon from "./icons/YouTube.astro";
import { getSiteCopy, type Lang } from "../data/site";

interface Props {
  lang: Lang;
  homePath: string;
}

const { lang, homePath } = Astro.props;
const currentYear = new Date().getFullYear();
const copy = getSiteCopy(lang).footer;
const homeLabel = lang === "es" ? "Inicio" : "Home";
const socials = [
  { name: "GitHub", url: "https://github.com/RodReBer", icon: GitHubIcon },
  { name: "LinkedIn", url: "https://www.linkedin.com/in/rodrigorey2005/", icon: LinkedInIcon },
  { name: "YouTube", url: "https://www.youtube.com/@rodrigorey9706/videos", icon: YouTubeIcon },
];
---

<footer class="site-footer">
  <div class="site-shell footer-grid">
    <div class="footer-brand">
      <a class="footer-home" href={homePath} aria-label={`Rodrigo Rey — ${homeLabel}`}>
        <span class="cube-footer-dock" data-cube-footer-dock aria-hidden="true"></span>
      </a>
      <div>
        <strong>Rodrigo Rey</strong>
        <p>{copy.tagline}</p>
      </div>
    </div>

    <div class="social-links">
      {socials.map((social) => (
        <a href={social.url} target="_blank" rel="noopener noreferrer" aria-label={social.name}>
          <social.icon class="size-5" />
        </a>
      ))}
    </div>

    <p class="copyright">© {currentYear} Rodrigo Rey. {copy.rights}</p>
  </div>
</footer>

<style>
  .site-footer { position: relative; border-top: 4px solid var(--rubik-joint, #050609); padding-block: 2rem 2.5rem; box-shadow: inset 0 1px 0 var(--color-border); }
  .footer-grid { display: grid; gap: 1.5rem; }
  .footer-brand { display: flex; align-items: center; gap: 0.8rem; }
  .footer-home { display: inline-grid; width: 3.25rem; height: 3.25rem; flex: none; place-items: center; border-radius: 0.45rem; }
  .cube-footer-dock { display: block; width: 100%; height: 100%; pointer-events: none; }
  .footer-brand strong { display: block; font-size: 0.95rem; }
  .footer-brand p, .copyright { margin: 0.2rem 0 0; color: var(--color-muted); font-size: 0.8rem; }
  .social-links { display: flex; gap: 0.5rem; }
  .social-links a { display: inline-flex; width: 2.75rem; height: 2.75rem; align-items: center; justify-content: center; border: 1px solid var(--color-border); border-radius: 0.5rem; color: var(--color-muted); transition: color var(--motion-fast), border-color var(--motion-fast), transform var(--motion-fast); }
  .social-links a:hover { border-color: var(--rubik-blue); color: var(--color-ink); transform: translateY(-2px); }
  @media (min-width: 700px) {
    .footer-grid { grid-template-columns: 1fr auto; align-items: center; }
    .copyright { grid-column: 1 / -1; padding-top: 1.25rem; border-top: 1px solid var(--color-border); }
  }
</style>
