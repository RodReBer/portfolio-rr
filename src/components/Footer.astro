---
import GitHubIcon from "../components/icons/GithubFooter.astro";
import YouTubeIcon from "../components/icons/YouTube.astro";
import LinkedInIcon from "../components/icons/LinkedIn.astro";

const currentYear = new Date().getFullYear();

const SOCIAL_LINKS = [
  {
    name: "GitHub",
    url: "https://github.com/RodReBer",
    icon: GitHubIcon,
  },
  {
    name: "LinkedIn",
    url: "https://www.linkedin.com/in/rodrigorey2005/",
    icon: LinkedInIcon,
  },
  {
    name: "YouTube",
    url: "https://www.youtube.com/@rodrigorey9706/videos",
    icon: YouTubeIcon,
  },
];
---

<footer class="relative z-10 border-t border-white/5">
  <div class="mx-auto max-w-6xl px-6 py-12">
    <!-- Top Section -->
    <div class="flex flex-col md:flex-row items-center justify-between gap-8">
      <!-- Logo & Tagline -->
      <div class="flex flex-col items-center md:items-start gap-2">
        <a href="/" class="text-2xl font-bold">
          <span class="text-cyan-400">RR</span>
          <span class="text-white">.</span>
        </a>
        <p class="text-gray-500 text-sm" data-i18n="footer.tagline">
          Building digital experiences
        </p>
      </div>

      <!-- Social Links -->
      <div class="flex items-center gap-4">
        {
          SOCIAL_LINKS.map((social) => (
            <a
              href={social.url}
              target="_blank"
              rel="noopener noreferrer"
              class="p-3 rounded-xl bg-white/5 text-gray-400 hover:text-cyan-400 hover:bg-cyan-400/10 transition-all duration-300"
              aria-label={social.name}
            >
              <social.icon class="w-5 h-5" />
            </a>
          ))
        }
      </div>
    </div>

    <!-- Bottom Section -->
    <div
      class="mt-8 pt-8 border-t border-white/5 flex flex-col md:flex-row items-center justify-between gap-4 text-center md:text-left"
    >
      <p class="text-gray-500 text-sm">
        © {currentYear} Rodrigo Rey. <span data-i18n="footer.rights"
          >All rights reserved.</span
        >
      </p>

    </div>
  </div>
</footer>
