---
interface Props {
  eyebrow: string;
  title: string;
  description?: string;
  accent?: "blue" | "green" | "orange" | "yellow";
}

const { eyebrow, title, description, accent = "yellow" } = Astro.props;
const accentMap = {
  blue: "var(--rubik-blue)",
  green: "var(--rubik-green)",
  orange: "var(--rubik-orange)",
  yellow: "var(--rubik-yellow)",
};

const faceMap = {
  blue: { index: "01", move: "B", active: [0, 1, 2, 4] },
  green: { index: "02", move: "F", active: [2, 4, 5, 8] },
  orange: { index: "03", move: "L", active: [0, 1, 2, 4] },
  yellow: { index: "04", move: "D", active: [4, 6, 7, 8] },
} as const;

const face = faceMap[accent];
const faceCells = Array.from({ length: 9 }, (_, index) => index);
---

<header class="section-heading" style={`--section-accent:${accentMap[accent]}`} data-reveal>
  <div class="heading-kicker">
    <p class="eyebrow">{eyebrow}</p>
    <div class="face-notation" aria-hidden="true">
      <span class="move-code">{face.index} / {face.move}</span>
      <span class="mini-face">
        {faceCells.map((cell) => (
          <i class:list={{ active: face.active.some((activeCell) => activeCell === cell) }}></i>
        ))}
      </span>
    </div>
  </div>
  <h2>{title}</h2>
  {description && <p class="section-description">{description}</p>}
</header>

<style>
  .section-heading {
    position: relative;
    max-width: 48rem;
    padding-top: 1rem;
  }

  .section-heading::before {
    position: absolute;
    top: 0;
    left: 0;
    width: min(100%, 32rem);
    height: 1px;
    background: linear-gradient(90deg, var(--section-accent), rgba(255, 255, 255, 0.1) 42%, transparent);
    content: "";
  }

  .heading-kicker {
    display: flex;
    min-height: 3rem;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .eyebrow {
    margin: 0;
  }

  .face-notation {
    display: inline-flex;
    flex: none;
    align-items: center;
    gap: 0.65rem;
  }

  .move-code {
    color: color-mix(in srgb, var(--section-accent) 76%, var(--color-ink));
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.66rem;
    font-weight: 800;
    letter-spacing: 0.12em;
  }

  .mini-face {
    display: grid;
    width: 2.8rem;
    height: 2.8rem;
    grid-template-columns: repeat(3, 1fr);
    gap: 2px;
    padding: 3px;
    border: 1px solid #30343e;
    border-radius: 0.42rem;
    background: #050608;
    box-shadow:
      0 8px 20px rgba(0, 0, 0, 0.28),
      inset 0 1px 0 rgba(255, 255, 255, 0.06);
  }

  .mini-face i {
    border: 1px solid rgba(255, 255, 255, 0.025);
    border-radius: 1px;
    background: #171a20;
    box-shadow: inset 0 1px 1px rgba(255, 255, 255, 0.025);
  }

  .mini-face i.active {
    border-color: color-mix(in srgb, var(--section-accent) 74%, white);
    background: var(--section-accent);
    box-shadow: inset 0 1px 1px rgba(255, 255, 255, 0.28);
  }

  h2 {
    max-width: 17ch;
    margin: 0.8rem 0 0;
    font-size: clamp(2rem, 5vw, 4.35rem);
    font-weight: 780;
    letter-spacing: -0.045em;
    line-height: 0.98;
    text-wrap: balance;
  }

  .section-description {
    max-width: 42rem;
    margin: 1.15rem 0 0;
    color: var(--color-muted);
    font-size: clamp(1rem, 1.5vw, 1.12rem);
    line-height: 1.7;
    text-wrap: pretty;
  }

  @media (max-width: 420px) {
    .move-code {
      display: none;
    }

    .mini-face {
      width: 2.55rem;
      height: 2.55rem;
    }
  }
</style>
